.minDimensions_r { min-height: 40px; min-width: 180px; }

.caret_r { fill: currentcolor; pointer-events: none; }

.caretPrimary_r { color: var(--sema-color-background-elevation); }

.caretSecondary_r { color: rgb(17, 17, 17); }

